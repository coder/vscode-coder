{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"printWidth": 80,
	// Disabled to avoid churning the key order of every package.json in the repo.
	"sortPackageJson": false,
	"ignorePatterns": [
		"/dist/",
		"/node_modules/",
		"/out/",
		"/.vscode-test/",
		"/coverage/",
		"*.vsix",
		"flake.lock",
		"pnpm-lock.yaml",
		"/storybook-static/",
		"**/__golden__/",
		".storybook/themes/generated/"
	],
	"overrides": [
		{
			"files": ["*.jsonc"],
			"options": {
				"trailingComma": "none"
			}
		}
	]
}
